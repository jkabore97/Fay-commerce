# ─────────────────────────────────────────────────────────────────────────────
# Fay & Partenaires — variables d'environnement
#
# Copiez ce fichier vers .env.local et renseignez les valeurs de VOTRE projet
# Supabase. Ne committez JAMAIS .env.local (il est ignoré par git).
#
# Le site fonctionne SANS Supabase : le catalogue et le tableau de bord auront
# simplement besoin de la base pour afficher des données. Le contenu vitrine
# (accueil, à-propos, contact) s'affiche avec des valeurs par défaut intégrées.
# ─────────────────────────────────────────────────────────────────────────────

# URL du projet Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Clé "publishable" / anon (publique par conception — la sécurité repose sur RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Clé service_role — SECRÈTE. Utilisée uniquement côté serveur pour les tâches
# d'administration (création de comptes employés par un admin). NE JAMAIS
# exposer côté client, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Nom du bucket Storage public pour les images (produits, bannières, partenaires)
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media

# URL publique du site (utilisée pour les métadonnées SEO et les liens absolus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
